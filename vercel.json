{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {"source": "/projects", "destination": "/projects/index.html"},
    {"source": "/projects/shop", "destination": "/projects/shop/index.html"},
    {"source": "/projects/shop/:page", "destination": "/projects/shop/:page/index.html"},
    {"source": "/projects/shop/auth/callback", "destination": "/projects/shop/auth/callback/index.html"}
  ]
}
